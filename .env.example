# =============================================================================
# TutorIA — variables de docker-compose.yml (tu equipo y la EC2 usan este mismo formato).
# Copia este archivo a .env:
#   Linux/macOS:  cp .env.example .env
#   PowerShell:   Copy-Item .env.example .env
#   cmd:          copy .env.example .env
#
# Por defecto TODO es falso/local: arranca sin llaves, sin AWS y sin red externa.
# [SECRETO] = no lo compartas ni lo subas a ningún repositorio.
# ATENCIÓN: `docker compose config` imprime estos valores. No pegues su salida en ningún lado.
#
# Generar secretos (64 caracteres hexadecimales):
#   Linux/macOS:  openssl rand -hex 32
#   PowerShell:   [Convert]::ToHexString((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
#   Python:       python -c "import secrets; print(secrets.token_hex(32))"
# =============================================================================

# --- Ubicación de los repositorios -------------------------------------------
# Por defecto el compose construye ./backend y ./frontend (deploy/clonar.sh los trae ahí).
# Si los tienes como carpetas hermanas de tutorIa-compose, descomenta:
# BACKEND_DIR=../tutorIa-backend
# FRONTEND_DIR=../tutorIa-frontend

# --- Despliegue (solo lo leen el compose y los scripts, no el backend) --------
# Dirección que atiende Caddy. Local: :80 (HTTP). Producción: el dominio, p. ej. tutoria.<tu-dominio>
SITE_ADDRESS=:80
# Origen exacto del sitio (esquema+host+puerto). El compose lo pasa al backend como CORS_ORIGINS.
# Local: http://localhost:8080 · Producción: https://tutoria.<tu-dominio>
APP_ORIGIN=http://localhost:8080
# Interfaz y puertos publicados por Caddy. Local: 127.0.0.1/8080/8443 · EC2: 0.0.0.0/80/443
WEB_BIND=127.0.0.1
WEB_PORT=8080
WEB_HTTPS_PORT=8443
# Región de AWS (el compose la pasa al backend como AWS_DEFAULT_REGION y KMS_REGION).
AWS_REGION=us-east-1

# --- Base de datos -----------------------------------------------------------
POSTGRES_USER=tutoria
# [SECRETO] Sin @ : / ? # % (va dentro de una URL). Genérala con: openssl rand -hex 24
POSTGRES_PASSWORD=cambia-esto-clave-bd
POSTGRES_DB=tutoria

# --- General y sesión --------------------------------------------------------
# development | production (production rechaza proveedores fake/local y secretos cortos)
APP_ENV=development
# [SECRETO] Firma de las sesiones. Mínimo 32 caracteres en producción.
JWT_SECRET=cambia-esto-jwt-secreto-de-desarrollo-000000
# false en local (HTTP); true en producción (HTTPS)
COOKIE_SECURE=false
# Vacío = cookie de un solo host (recomendado: front y API comparten origen tras Caddy)
COOKIE_DOMAIN=
# Base de los enlaces de los correos. Local: http://localhost:8080
# Producción: la URL de la Lambda despertador (deploy/despertador) o, si no la usas, igual a APP_ORIGIN
FRONTEND_URL=http://localhost:8080

# --- Cifrado de columnas (local | kms) ----------------------------------------
# [SECRETO] Clave HMAC del índice ciego (correo) y seudónimos. Mínimo 32 caracteres.
INDICE_CIEGO_CLAVE=cambia-esto-indice-ciego-de-desarrollo-0000
# local SOLO para desarrollo. Producción: kms + KMS_KEY_ID + CIFRADO_DEK_ENVUELTA
CIFRADO_PROVEEDOR=local
# [SECRETO] Clave AES-256 en base64 (solo local). Genera una con:
#   docker compose run --rm backend python -m app.scripts.generar_clave_local
# Vacía = clave de desarrollo incorporada en el código.
# CIFRADO_CLAVE_LOCAL=
# Producción: DEK envuelta por KMS (python -m app.scripts.generar_dek_kms). Guarda una copia
# FUERA de la instancia: sin ella y sin la clave KMS los datos cifrados son irrecuperables.
CIFRADO_DEK_ENVUELTA=
# Producción: alias/tutoria-prod
KMS_KEY_ID=

# --- Archivos del estudiante (local | s3) -------------------------------------
# local solo en desarrollo (volumen tutoria_archivos). Producción: s3
ALMACEN_PROVEEDOR=local
S3_BUCKET=
S3_REGION=us-east-1
ARCHIVO_RETENCION_DIAS=180

# --- Claude (fake | anthropic) ------------------------------------------------
LLM_PROVIDER=fake
# [SECRETO] Llave de la consola de Anthropic (cuenta comercial de API)
LLM_API_KEY=
# Verifica los identificadores vigentes en la documentación de Anthropic y con
#   docker compose exec backend python -m app.scripts.probar_llm
LLM_MODEL_SENCILLO=claude-haiku-5-5
LLM_MODEL_COMPLEJO=claude-sonnet-5-5

# --- OpenAI: moderación e ilustraciones de último recurso --------------------
# [SECRETO] Llave de proyecto de OpenAI con límite de gasto
OPENAI_API_KEY=
# fake | openai (producción: openai)
MODERACION_PROVEEDOR=fake
# Ilustraciones IA (último recurso). Requiere OPENAI_API_KEY e IMAGENES_IA_PROVEEDOR=openai
IMAGENES_IA_ACTIVA=false
# IMAGENES_IA_PROVEEDOR=openai

# --- Fuentes e imágenes abiertas ----------------------------------------------
# Sin definir = proveedores "fake" (sin red). Para el modo real copia las listas JSON de
# backend/.env.example (FUENTES_PROVEEDORES, IMAGENES_PROVEEDORES) en UNA sola línea.
# No dejes la variable vacía (FUENTES_PROVEEDORES=): un valor vacío no es JSON válido.
# FUENTES_PROVEEDORES=[...]
# IMAGENES_PROVEEDORES=[...]
# Exigido por los proveedores públicos: nombre del servicio y un contacto real
FUENTES_USER_AGENT=TutorIA/0.1 (contacto: datos@<tu-dominio>)
IMAGENES_USER_AGENT=TutorIA/0.1 (contacto: datos@<tu-dominio>)

# --- Videos -------------------------------------------------------------------
# fake | youtube (producción exige youtube; con búsqueda dinámica desactivada usa los videos curados)
VIDEOS_PROVEEDOR=fake
VIDEOS_BUSQUEDA_DINAMICA=false
# [SECRETO] Solo si VIDEOS_BUSQUEDA_DINAMICA=true (la cuota diaria por defecto es baja)
YOUTUBE_API_KEY=

# --- Correo (fake | ses) ------------------------------------------------------
# fake imprime el enlace de autorización en los logs del backend (solo desarrollo)
CORREO_PROVEEDOR=fake
SES_REGION=us-east-1
CORREO_REMITENTE=no-responder@tutoria.local

# --- Tutor y protección de datos (Ley 1581) ------------------------------------
TUTOR_NOMBRE=Vex
# Obligatorios en producción. Solo en el .env de cada máquina, NUNCA en el repositorio.
RESPONSABLE_RAZON_SOCIAL=
RESPONSABLE_NIT=
RESPONSABLE_DOMICILIO=
RESPONSABLE_CORREO_DATOS=
POLITICA_VERSION=1
POLITICA_VERSION_MINIMA_ACEPTADA=1

# --- Opcionales ---------------------------------------------------------------
# Cualquier otra variable de backend/.env.example (topes, límites, TARIFAS_IA, timeouts...)
# puede agregarse aquí; si no está, se usa el valor por defecto del backend.
# Cadena de timeouts: Caddy (120 s) > CHAT_TIMEOUT_TURNO_SEGUNDOS (100) > LLM_TIMEOUT_SEGUNDOS (45)
# Pool: DB_POOL_SIZE (5) + DB_MAX_OVERFLOW (10) = 15 < max_connections de PostgreSQL (100)
