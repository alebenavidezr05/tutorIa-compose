{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DescribirNoAdmiteRecurso",
      "Effect": "Allow",
      "Action": "ec2:DescribeInstances",
      "Resource": "*"
    },
    {
      "Sid": "EncenderSoloEstaInstancia",
      "Effect": "Allow",
      "Action": "ec2:StartInstances",
      "Resource": "arn:aws:ec2:<region>:<cuenta>:instance/<instance-id>"
    },
    {
      "Sid": "ClaveDelDiscoCifrado",
      "Effect": "Allow",
      "Action": "kms:CreateGrant",
      "Resource": "arn:aws:kms:<region>:<cuenta>:key/<kms-key-id>",
      "Condition": { "Bool": { "kms:GrantIsForAWSResource": "true" } }
    }
  ]
}
