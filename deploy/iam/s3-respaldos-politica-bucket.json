{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "NegarSinTLS",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": ["arn:aws:s3:::<bucket-respaldos>", "arn:aws:s3:::<bucket-respaldos>/*"],
      "Condition": { "Bool": { "aws:SecureTransport": "false" } }
    }
  ]
}
